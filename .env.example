# 複製成 .env 後填入。金鑰只放這裡，不要寫進程式、不要上傳 GitHub（.gitignore 已排除 .env）。

# ===== 解讀後端（第 3-2、9-1）=====
# mock（不填金鑰時的預設，離線）| anthropic | openai | deepseek | gemini | openai_compatible
# 課程建議接 deepseek（DeepSeek-V4.1-Flash）：一份解讀不到 $0.01、查核通過率與貴 30 倍的 Opus 相同；原因與資料政策考量見 docs/model-choice.md
LLM_BACKEND=mock
LLM_API_KEY=
# 模型留空用該家預設：anthropic→claude-opus-5-5、openai→gpt-4o-mini、deepseek→deepseek-flash（DeepSeek-V4.1-Flash；deepseek-chat 為別名）、gemini→gemini-2.5-flash
# 一份八字解讀實測費用（docs/validation-models.md）：deepseek-flash $0.005（課程預設）、claude-haiku-5-5 $0.003、gemini-2.5-flash $0.006、claude-sonnet-5-5 $0.09、claude-opus-5-5 $0.14
LLM_MODEL=
# 只有 openai_compatible 需要：Ollama http://localhost:11434/v1、LM Studio http://localhost:1234/v1、Groq https://api.groq.com/openai/v1
LLM_BASE_URL=
# 思考深度：default（用各家預設，品質最穩）| off（不思考：約省 1/3 費用、快一倍，查核偶爾少過一項）| low | high
# DeepSeek → thinking.type=disabled / reasoning_effort；OpenAI、Gemini → reasoning_effort（需推理型模型）；Claude → output_config.effort
LLM_THINKING=default
READING_MAX_TOKENS=8000
# ↑ 思考型模型（DeepSeek V4、Claude、o 系列）的推理 token 也算在內，太低會把六段解讀截斷；程式偵測到截斷會自動加倍重試一次

# 各家金鑰申請：Anthropic console.anthropic.com｜OpenAI platform.openai.com｜DeepSeek platform.deepseek.com｜Gemini aistudio.google.com
# 舊欄位仍可用（只對 anthropic）：ANTHROPIC_API_KEY、ANTHROPIC_MODEL

# 用量上限（第 8 章）：每個 IP 每日次數、全站每日解讀次數、每日預算（美元）
RATE_LIMIT_PER_IP_PER_DAY=20
DAILY_READING_CAP=500
DAILY_BUDGET_USD=5

# 緊急開關：設成 1 全站暫停（回 503）
MAINTENANCE=0

# 流派：schools/<名字>.yaml（default＝課程預設；clock-time＝手錶時間派；zhongqi-tianfu＝中氣命宮・天府化科派）
SCHOOL=default

# 命理師人設：persona/<名字>.yaml（master＝玄機；yuelao＝專看感情的月老）
PERSONA=master

# 對話紀錄保存（小時），0 = 只放記憶體、重啟即清
SESSION_TTL_HOURS=24

# Telegram 機器人（選做）
TELEGRAM_BOT_TOKEN=
API_HOST=0.0.0.0
API_PORT=8000
